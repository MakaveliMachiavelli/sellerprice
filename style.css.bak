/* SellerPrice — styles */
:root{
  --orange:#c2410c; --ink:#101828; --muted:#667085; --line:#e4e7ec;
  --bg:#fdf6f0; --card:#fff; --green:#0e9f6e; --red:#dc2626;
}
*{box-sizing:border-box}
body{margin:0;font-family:'Segoe UI',system-ui,-apple-system,Arial,sans-serif;background:var(--bg);color:var(--ink);line-height:1.5}
.hidden{display:none!important}

.site-header{position:sticky;top:0;z-index:50;background:#fff;border-bottom:1px solid var(--line);display:flex;justify-content:space-between;align-items:center;padding:.7rem 1.2rem}
.brand{font-weight:800;font-size:1.3rem;letter-spacing:-.02em}
.brand span{color:var(--orange)}
.site-header nav{display:flex;gap:1rem;align-items:center}
.site-header a{color:var(--muted);text-decoration:none;font-weight:600}
.btn-link{border:none;background:var(--orange);color:#fff;font-weight:700;padding:.45rem .9rem;border-radius:8px;cursor:pointer}
.badge{font-size:.7rem;font-weight:800;padding:.2rem .5rem;border-radius:99px;background:var(--green);color:#fff}

.wrap{max-width:1150px;margin:0 auto;padding:1.5rem 1.2rem}
.hero{text-align:center;padding:1.2rem 0 .8rem}
.hero h1{font-size:clamp(1.7rem,4vw,2.5rem);margin:0 0 .4rem;letter-spacing:-.03em}
.hero .sub{color:var(--muted);max-width:780px;margin:0 auto}
.hero-chips{display:flex;flex-wrap:wrap;gap:.5rem;justify-content:center;margin-top:1rem}
.hero-chips span{background:#ffe8d9;color:#9a3412;font-size:.8rem;font-weight:700;padding:.3rem .7rem;border-radius:99px}

.app-grid{display:grid;grid-template-columns:1fr 1fr;gap:1.2rem;margin-top:1.2rem}
@media(max-width:960px){.app-grid{grid-template-columns:1fr}}
.panel{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:1.2rem}
.panel h2{font-size:.95rem;text-transform:uppercase;letter-spacing:.06em;color:var(--muted);margin:1rem 0 .6rem}
.panel h2:first-child{margin-top:0}
.preview-title{margin-top:0}
.tiny{font-weight:400;text-transform:none;letter-spacing:0;font-size:.72rem}

.fields{display:grid;gap:.6rem}
.fields.three{grid-template-columns:1fr 1fr 1fr}
@media(max-width:700px){.fields.three{grid-template-columns:1fr}}
label{display:flex;flex-direction:column;gap:.25rem;font-size:.8rem;font-weight:600;color:var(--muted)}
input,select{border:1px solid var(--line);border-radius:8px;padding:.5rem .6rem;font-size:.95rem;font-family:inherit;background:#fff;color:var(--ink)}
input:focus,select:focus{outline:2px solid #fed7aa;border-color:var(--orange)}
.hint{color:var(--muted);font-size:.78rem}

.stat-row{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:.6rem;margin-bottom:1rem}
.stat{background:#fbf7f4;border:1px solid var(--line);border-radius:10px;padding:.7rem;text-align:center}
.stat.hi{background:#ffedd5;border-color:#fdba74}
.stat-l{font-size:.64rem;font-weight:800;letter-spacing:.05em;color:var(--muted)}
.stat-v{font-size:1.3rem;font-weight:900;margin-top:.15rem}
.stat-v.neg{color:var(--red)}

.price-doc{background:#fff;border:1px solid #cbd5e1;border-radius:6px;padding:1.2rem;font-size:.85rem;box-shadow:0 1px 4px rgba(16,24,40,.06)}
.pd-head{font-weight:900;letter-spacing:.12em;border-bottom:2px solid var(--ink);padding-bottom:.35rem;margin-bottom:.6rem}
.pd-table{width:100%;border-collapse:collapse;font-size:.82rem}
.pd-table td{border-bottom:1px solid var(--line);padding:.4rem .3rem}
.pd-table .r{text-align:right}
.pd-table tr.tot td{border-top:2px solid var(--ink);border-bottom:none;font-size:.95rem}
.pd-foot{margin-top:.7rem;font-size:.64rem;color:var(--muted);text-align:center}

.plat-table{width:100%;border-collapse:collapse;font-size:.85rem;margin-top:.4rem}
.plat-table th{border-bottom:1.5px solid var(--ink);text-align:left;padding:.3rem;font-size:.68rem;letter-spacing:.05em}
.plat-table td{border-bottom:1px solid var(--line);padding:.4rem .3rem}
.plat-table .r{text-align:right}

.actions{display:flex;flex-wrap:wrap;gap:.6rem;margin-top:1.1rem}
.btn{border:1px solid var(--line);background:#fff;border-radius:10px;padding:.6rem 1rem;font-weight:700;cursor:pointer;font-size:.95rem}
.btn:hover{background:#faf6f2}
.btn.primary{background:var(--orange);border-color:var(--orange);color:#fff}
.btn.primary:hover{background:#9a3412}
.btn.big{width:100%;font-size:1.05rem;padding:.8rem}

.marketing{margin-top:2.5rem}
.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:1rem}
.card{background:#fff;border:1px solid var(--line);border-radius:14px;padding:1.1rem}
.card h3{margin:.1rem 0 .4rem;font-size:1.02rem}
.card p{color:var(--muted);font-size:.9rem;margin:0}
.faq-item{background:#fff;border:1px solid var(--line);border-radius:12px;padding:1rem 1.2rem;margin-bottom:.7rem}
.faq-item h3{margin:0 0 .35rem;font-size:1rem}
.faq-item p{margin:0;color:var(--muted);font-size:.92rem}
.faq-item code{background:#fff3ea;padding:.05rem .35rem;border-radius:4px;font-size:.85em}
.cta-box{background:linear-gradient(135deg,#c2410c,#9a3412);color:#fff;border-radius:16px;padding:1.6rem;margin-top:2rem}
.cta-box h2{margin:0 0 .6rem}
.cta-box ul{margin:0 0 .6rem;padding-left:1.2rem}
.once{color:#ffe3d1;font-size:.85rem;margin:.4rem 0 .9rem}

.modal{position:fixed;inset:0;background:rgba(16,24,40,.55);display:flex;align-items:center;justify-content:center;z-index:100;padding:1rem}
.modal-card{background:#fff;border-radius:16px;padding:1.5rem;max-width:440px;width:100%;position:relative;max-height:90vh;overflow:auto}
.modal-card.wide{max-width:680px}
.modal-x{position:absolute;top:.7rem;right:.7rem;border:none;background:#f2f4f7;border-radius:8px;width:30px;height:30px;cursor:pointer;font-weight:700}
.price{font-size:1.6rem;font-weight:900;margin:.2rem 0 .8rem}
.price span{font-size:.8rem;font-weight:600;color:var(--muted)}
.qr-box{display:flex;gap:1rem;align-items:flex-start}
.qr-box img{border:1px solid var(--line);border-radius:8px;background:#fff}
.pay-steps{margin:0;padding-left:1.1rem;font-size:.85rem;color:var(--muted)}
.code-row{display:flex;gap:.5rem;margin-top:1rem}
.code-row input{flex:1}
.code-msg{font-size:.85rem;min-height:1.2rem;margin:.5rem 0 0;font-weight:700}
.code-msg.ok{color:var(--green)}
.code-msg.bad{color:var(--red)}
.book-table{width:100%;border-collapse:collapse;font-size:.8rem;margin:.6rem 0}
.book-table th{border-bottom:2px solid var(--ink);text-align:left;padding:.3rem}
.book-table td{border-bottom:1px solid var(--line);padding:.35rem .3rem}
.book-table .r{text-align:right}
.x-btn{border:none;background:#fee2e2;color:var(--red);border-radius:6px;cursor:pointer;font-weight:800;padding:.25rem .5rem}
.batch-add{display:grid;grid-template-columns:2fr 1fr auto;gap:.5rem;margin-bottom:.5rem}

.site-footer{border-top:1px solid var(--line);margin-top:2.5rem;padding:1.2rem;text-align:center;color:var(--muted);font-size:.78rem}
.site-footer a{color:var(--orange)}

@media print{
  body *{visibility:hidden}
  #doc,#doc *{visibility:visible}
  #doc{position:absolute;left:0;top:0;width:100%;border:none;box-shadow:none;padding:0}
  @page{margin:14mm}
}
.check-label{display:flex;align-items:center;gap:.5rem;font-size:.8rem;font-weight:600;color:var(--muted);cursor:pointer;padding-top:1.2rem}
.check-label input{width:auto}
